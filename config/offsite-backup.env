# Smart Assistance - Offsite Backup Google Drive plain
# Non contiene token OAuth.
SA_OFFSITE_PROVIDER=google-drive-rclone
SA_OFFSITE_RCLONE_EXE=C:\SmartAssistance\tools\rclone\rclone.exe
SA_OFFSITE_RCLONE_CONFIG=C:\SmartAssistance\secrets\rclone\rclone.conf
SA_OFFSITE_REMOTE=sa-gdrive:SmartAssistance_Backups
SA_OFFSITE_RETENTION_DAYS=90
SA_OFFSITE_UPLOAD_MODE=copy