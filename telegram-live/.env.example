# Smart Assistance - Telegram Live account reader

# Dati da my.telegram.org > API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Sessione dell'account Telegram dedicato
TELEGRAM_SESSION_FILE=/app/session/telegram.session

# Backend Smart Assistance dentro la rete Docker
SMARTASSISTANCE_BACKEND_URL=http://sa-backend:3006

# Deve essere identico a LIVE_IMPORT_SECRET in C:\SmartAssistance\backend\.env
LIVE_IMPORT_SECRET=CHANGE_ME

# Polling canali reali
TELEGRAM_LIVE_POLL_SECONDS=60
TELEGRAM_LIVE_LOOKBACK=20

# false = al primo avvio marca come già letti i messaggi esistenti
# true = importa anche gli ultimi messaggi già presenti
TELEGRAM_IMPORT_OLD_ON_FIRST_RUN=false
